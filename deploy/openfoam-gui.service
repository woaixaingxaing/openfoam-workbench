[Unit]
Description=OpenFOAM Workbench GUI
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# %h 会展开为 User= 指定用户的家目录；换用户名时只需改上面的 User/Group。
WorkingDirectory=%h/OpenFOAM/gui
ExecStart=/usr/bin/python3 %h/OpenFOAM/gui/openfoam_gui.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PULSE_SERVER=unix:/mnt/wslg/PulseServer

[Install]
WantedBy=multi-user.target
